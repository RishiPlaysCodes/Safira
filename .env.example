# =============================================================================
# SafeRide Guardian - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
#
# Usage with Docker Compose:
#   cp .env.example .env
#   # Edit .env with your values
#   docker compose up -d
# =============================================================================

# ---------------------------------------------------------------------------
# DJANGO CORE (REQUIRED)
# ---------------------------------------------------------------------------
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string

# Set to True only for local development
DJANGO_DEBUG=False

# Comma-separated list of allowed hostnames
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# ---------------------------------------------------------------------------
# DATABASE (REQUIRED)
# ---------------------------------------------------------------------------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=saferide
DB_USER=saferide
DB_PASSWORD=change-me-strong-password
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=600

# ---------------------------------------------------------------------------
# CACHE / REDIS
# ---------------------------------------------------------------------------
CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
CACHE_LOCATION=redis://redis:6379/0
CACHE_TIMEOUT=300

# ---------------------------------------------------------------------------
# CORS (comma-separated origins allowed to call the API)
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# ---------------------------------------------------------------------------
# RATE LIMITING
# ---------------------------------------------------------------------------
THROTTLE_ANON=20/minute
THROTTLE_USER=120/minute
THROTTLE_ACCIDENT=10/minute

# ---------------------------------------------------------------------------
# FIREBASE PUSH NOTIFICATIONS
# ---------------------------------------------------------------------------
# Path to your Firebase service account JSON key file
FIREBASE_CREDENTIALS_PATH=

# ---------------------------------------------------------------------------
# NOTIFICATION PROVIDER
# ---------------------------------------------------------------------------
# Options: free (simulated), twilio (real SMS/calls)
NOTIFICATION_PROVIDER=free

# Twilio credentials (required if NOTIFICATION_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------------------------------------------------------------------------
# AMBULANCE INTEGRATION
# ---------------------------------------------------------------------------
# Options: free (simulated), webhook (sends HTTP POST to URL)
AMBULANCE_PROVIDER=free
AMBULANCE_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# VISION AI PROVIDER
# ---------------------------------------------------------------------------
# Options: free_manual (pass-through), on_device (mobile ML)
VISION_PROVIDER=free_manual

# ---------------------------------------------------------------------------
# TRAFFIC PROVIDER
# ---------------------------------------------------------------------------
TRAFFIC_PROVIDER=free_manual

# ---------------------------------------------------------------------------
# MONITORING
# ---------------------------------------------------------------------------
# Sentry DSN for error tracking (leave empty to disable)
SENTRY_DSN=

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
