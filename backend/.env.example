# SafeRide Guardian - Backend Configuration
# Copy this file to .env and fill in your values

# Django Secret Key (generate a new one for production)
SECRET_KEY=django-insecure-change-this-in-production

# Debug Mode (set to False in production)
DEBUG=True

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=127.0.0.1,localhost

# ============ NOTIFICATION PROVIDERS ============

# Provider: 'free' (simulated) or 'twilio' (production)
NOTIFICATION_PROVIDER=free

# Twilio Configuration (required if NOTIFICATION_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ============ FIREBASE (Push Notifications) ============

# Path to Firebase service account JSON file
FIREBASE_CREDENTIALS_PATH=

# ============ AMBULANCE DISPATCH ============

# Provider: 'free' (simulated) or 'webhook' (real integration)
AMBULANCE_PROVIDER=free
AMBULANCE_WEBHOOK_URL=

# ============ VISION / AI ============

# Provider: 'free_manual' (button-based) or 'on_device' (camera AI)
VISION_PROVIDER=free_manual

# ============ TRAFFIC ============

# Provider: 'free_manual' (speed heuristic) or 'external_api' (Google/HERE)
TRAFFIC_PROVIDER=free_manual
TRAFFIC_API_KEY=

# ============ PRODUCTION DEPLOYMENT ============

# Database URL (for production, use PostgreSQL)
# DATABASE_URL=postgres://user:password@host:5432/saferide

# Static files
# STATIC_ROOT=/var/www/static/
